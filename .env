# ArtFolio — local environment variables
#
# This file is loaded by flutter_dotenv (see lib/main.dart) and is listed
# under `flutter: assets:` in pubspec.yaml so Flutter can find it at
# runtime. It must NEVER be committed — .gitignore already excludes it.
#
# Get these two values from your Supabase project:
# Project Settings -> Data API -> Project URL, and
# Project Settings -> API Keys -> anon / public key.
# The anon key is safe to ship in a client app; Row Level Security is what
# actually restricts writes to the admin account. Never put the
# service_role key here.

SUPABASE_URL=https://nkyxbjcgxdqbghlcpzry.supabase.co/rest/v1/
SUPABASE_ANON_KEY=sb_publishable_ziEPPuNOEt4SKEEBznuyeg_RA_PwZc_